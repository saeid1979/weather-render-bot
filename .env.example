# Default / main bot
TELEGRAM_BOT_TOKEN=your_main_bot_token
TELEGRAM_CHAT_ID=your_admin_chat_id_for_main_bot

# Multi-Bot options
# Method 1: add extra bots as separate env vars
BOT_TOKEN_SECOND=your_second_bot_token
BOT_TOKEN_RESTAURANT=your_restaurant_bot_token
DEFAULT_BOT_KEY=main

# Method 2 alternative: JSON map
# BOT_TOKENS_JSON={"main":"token1","second":"token2"}

PUBLIC_URL=https://weather-render-bot.onrender.com
PORT=3000
TIMEZONE=Europe/Madrid
RAIN_THRESHOLD=50
WIND_WARNING_KMH=55
UV_WARNING=7
HEAT_WARNING_C=35
COLD_WARNING_C=0
ENABLE_INTERNAL_CRON=true
ADMIN_PASSWORD=change-this-password

# Hourly Persian world news + morning FX report
NEWS_ENABLED=true
NEWS_RSS_URL=https://news.google.com/rss/headlines/section/topic/WORLD?hl=fa&gl=IR&ceid=IR:fa
NEWS_MAX_ITEMS=5
NEWS_MAX_AGE_MINUTES=180
FX_ENABLED=true
FX_REPORT_TIME=08:00
FX_API_URL=https://open.er-api.com/v6/latest/USD
FX_CURRENCIES=USD,EUR,GBP,AED,TRY,CAD,CHF,JPY,CNY,AUD
